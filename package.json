{
  "name": "@zc0982/dsh-gpt-211api-provider",
  "version": "0.1.0",
  "description": "GPT 211API provider preset with complete reasoning effort selection for DeepSeek Harness",
  "type": "module",
  "main": "./lib/index.js",
  "types": "./lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": ["lib", "cordis.patch.yml", "README.md", "LICENSE"],
  "dsh": { "bundle": { "patch": "./cordis.patch.yml" } },
  "keywords": ["deepseek-harness", "dsh", "gpt", "reasoning-effort", "211api"],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zc0982/dsh-gpt-211api-provider.git"
  },
  "bugs": { "url": "https://github.com/zc0982/dsh-gpt-211api-provider/issues" },
  "homepage": "https://github.com/zc0982/dsh-gpt-211api-provider#readme",
  "engines": { "node": "^22.19.0 || >=24.0.0" },
  "dependencies": {
    "@deepseek-ai/dsh-agent-default-model": "^0.1.0-rc.7",
    "@deepseek-ai/dsh-llm-pi-ai": "^0.1.0-rc.7"
  },
  "devDependencies": {
    "typescript": "^5.9.0"
  },
  "scripts": {
    "build": "bash scripts/build.sh",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  }
}
